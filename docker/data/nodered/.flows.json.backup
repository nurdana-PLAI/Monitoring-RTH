    },
    {
        "id": "d164f35b30b2030b",
        "type": "function",
        "z": "dab6edf519d82253",
        "name": "function 4",
        "func": "const rows = msg.payload.dataset || [];\n\nmsg.payload = rows.map(row => ({\n    timestamp: row[0],\n    value: row[1],\n    ikl: row[2]\n}));\n\nmsg.headers = {\n    \"Access-Control-Allow-Origin\": \"*\",\n    \"Access-Control-Allow-Methods\": \"GET, OPTIONS\",\n    \"Access-Control-Allow-Headers\":\n        \"Content-Type, Authorization, X-Requested-With\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
