    {
        "id": "db64d626310d7aca",
        "type": "function",
        "z": "54179397647dbcc3",
        "name": "function 1",
        "func": "const query = `\nSELECT\n    max(timestamp) AS timestamp,\n    max(CASE WHEN sensor_type='temperature' THEN value END) AS temperature,\n    max(CASE WHEN sensor_type='humidity' THEN value END) AS humidity,\n    max(CASE WHEN sensor_type='soil_humidity' THEN value END) AS soil_humidity,\n    max(CASE WHEN sensor_type='pm25' THEN value END) AS pm25,\n    max(ikl) AS ikl,\n    max(ikl_label) AS ikl_label\nFROM (\n    SELECT *\n    FROM sensor_readings\n    LATEST ON timestamp PARTITION BY sensor_type\n)\n`;\n\nmsg.method = \"GET\";\n\n// Untuk sementara gunakan IP server\nmsg.url = \"http://questdb:9000/exec?query=\" + encodeURIComponent(query);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 320,
        "wires": [
            [
                "7568f854d6a95230"
            ]
        ]
    },
