    {
        "id": "a377ef5da1bd7114",
        "type": "function",
        "z": "dd89b028265e3a76",
        "name": "function 6",
        "func": "const headers = {\n    \"Access-Control-Allow-Origin\": \"*\",\n    \"Access-Control-Allow-Methods\": \"GET, OPTIONS\",\n    \"Access-Control-Allow-Headers\":\n        \"Content-Type, Authorization, X-Requested-With\",\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.headers = headers;\n\nconst rows = msg.payload?.dataset || [];\n\nmsg.statusCode = 200;\n\nmsg.payload = rows.map(row => ({\n    timestamp: row[0],\n    sensor_id: row[1],\n    sensor_type: row[2],\n    unit: row[3],\n    value: row[4],\n    ikl: row[5],\n    ikl_label: row[6]\n}));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
