    {
        "id": "4a7a02e32104aabc",
        "type": "function",
        "z": "54179397647dbcc3",
        "name": "function 2",
        "func": "const row = msg.payload.dataset[0];\n\nmsg.payload = {\n    timestamp: row[0],\n    temperature: row[1],\n    humidity: row[2],\n    soil_humidity: row[3],\n    pm25: row[4],\n    ikl: row[5],\n    ikl_label: row[6]\n};\n\nmsg.headers = {\n    \"Access-Control-Allow-Origin\": \"*\",\n    \"Access-Control-Allow-Methods\": \"GET, OPTIONS\",\n    \"Access-Control-Allow-Headers\": \"Content-TypeContent-Type, Authorization, X-Requested-With\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
