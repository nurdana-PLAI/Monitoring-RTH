    {
        "id": "6972aa24112c2f9e",
        "type": "http in",
        "z": "dd89b028265e3a76",
        "name": "API Raw",
        "url": "/api/history/raw",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 520,
        "y": 200,
        "wires": [
            [
                "ea06270e3f9fd96b"
            ]
        ]
    },
    {
        "id": "ea06270e3f9fd96b",
        "type": "function",
        "z": "dd89b028265e3a76",
        "name": "function 5",
        "func": "const period = String(\n    msg.req.query.period || \"24h\"\n).trim().toLowerCase();\n\nlet periodFilter = \"\";\n\nswitch (period) {\n    case \"24h\":\n        periodFilter = \"dateadd('h', -24, now())\";\n        break;\n\n    case \"weekly\":\n        periodFilter = \"dateadd('d', -7, now())\";\n        break;\n\n    case \"monthly\":\n        periodFilter = \"dateadd('d', -30, now())\";\n        break;\n\n    case \"yearly\":\n        periodFilter = \"dateadd('d', -365, now())\";\n        break;\n\n    default:\n        msg.statusCode = 400;\n        msg.payload = {\n            error: \"Periode tidak valid\",\n            received: period,\n            allowed: [\n                \"24h\",\n                \"weekly\",\n                \"monthly\",\n                \"yearly\"\n            ]\n        };\n        return msg;\n}\n\nconst query = `\nSELECT\n    timestamp,\n    loc_id,\n    sensor_id,\n    sensor_type,\n    unit,\n    value,\n    ikl,\n    ikl_label\nFROM sensor_readings\nWHERE timestamp >= ${periodFilter}\nORDER BY timestamp ASC;\n`;\n\nmsg.method = \"GET\";\n\nmsg.url =\n    \"http://questdb:9000/exec?query=\" +\n    encodeURIComponent(query);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 300,
        "wires": [
