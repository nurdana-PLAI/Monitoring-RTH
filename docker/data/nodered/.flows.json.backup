                "239c378813550bd9"
            ]
        ]
    },
    {
        "id": "239c378813550bd9",
        "type": "http response",
        "z": "dab6edf519d82253",
        "name": "",
        "statusCode": "",
        "headers": {},
        "x": 910,
        "y": 620,
        "wires": []
    },
    {
        "id": "5fc9d4b2681c94fe",
        "type": "http request",
        "z": "dab6edf519d82253",
        "name": "",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 830,
        "y": 480,
        "wires": [
            [
                "d164f35b30b2030b"
            ]
        ]
    },
    {
        "id": "1ffa608cae3f63da",
        "type": "function",
        "z": "dab6edf519d82253",
        "name": "function 3",
        "func": "const sensor = msg.req.query.sensor || \"temperature\";\nconst period = msg.req.query.period || \"24h\";\n\n// ===================================\n// VALIDASI SENSOR\n// ===================================\nconst allowedSensors = [\n    \"temperature\",\n    \"humidity\",\n    \"soil_humidity\",\n    \"pm25\"\n];\n\nif (!allowedSensors.includes(sensor)) {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Sensor tidak valid\",\n        sensor: sensor,\n        allowed: allowedSensors\n    };\n    return msg;\n}\n\n// ===================================\n// PERIODE\n// ===================================\nlet periodFilter = \"\";\nlet sampleBy = \"\";\n\nswitch (period) {\n\n    case \"24h\":\n        periodFilter = \"dateadd('h', -24, now())\";\n        sampleBy = \"5m\";\n        break;\n\n    case \"weekly\":\n        periodFilter = \"dateadd('d', -7, now())\";\n        sampleBy = \"1h\";\n        break;\n\n    case \"monthly\":\n        periodFilter = \"dateadd('d', -30, now())\";\n        sampleBy = \"6h\";\n        break;\n\n    case \"yearly\":\n        periodFilter = \"dateadd('d', -365, now())\";\n        sampleBy = \"1d\";\n        break;\n\n    default:\n        msg.statusCode = 400;\n        msg.payload = {\n            error: \"Periode tidak valid\",\n            period: period\n        };\n        return msg;\n}\n\n// ===================================\n// QUERY QUESTDB\n// ===================================\nconst query = `\nSELECT\n    timestamp,\n    avg(value) AS value,\n    avg(ikl) AS ikl\nFROM sensor_readings\nWHERE sensor_type = '${sensor}'\nAND timestamp >= ${periodFilter}\nSAMPLE BY ${sampleBy}\nORDER BY timestamp ASC;\n`;\n\nmsg.method = \"GET\";\n\nmsg.url =\n    \"http://questdb:9000/exec?query=\" +\n    encodeURIComponent(query);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 400,
        "wires": [
            [
                "5fc9d4b2681c94fe"
            ]
        ]
    }
