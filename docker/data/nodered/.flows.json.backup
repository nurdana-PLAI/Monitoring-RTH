    {
        "id": "aba1726303ba1a72",
        "type": "http in",
        "z": "54179397647dbcc3",
        "name": "API Latest",
        "url": "/api/latest",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 360,
