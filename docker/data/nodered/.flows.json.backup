    {
        "id": "generate_payload",
        "type": "function",
        "z": "555cdb144dd52a22",
        "name": "Generate Realistic Sensor Data",
        "func": "// Get current time in milliseconds (13 digits)\nconst ts_ms = Date.now();\n\n// Convert to nanoseconds (19 digits) by appending zeros as a string\n// This avoids JavaScript math precision loss\nconst ts_nanoseconds = ts_ms.toString() + \"000000\";\n\n// Convert to integer (BigInt is not needed, JS will parse this fine up to 19 digits for string formatting)\nconst ts_int = parseInt(ts_nanoseconds);\n\n// Generate realistic random values for Indonesian green infrastructure\nconst temperature = (Math.random() * 9.5 + 26.0).toFixed(2); // 26.0 to 35.5 °C\nconst humidity = (Math.random() * 35.0 + 60.0).toFixed(2);   // 60.0 to 95.0 %\nconst soil_humidity = (Math.random() * 40.0 + 30.0).toFixed(2); // 30.0 to 70.0 %\nconst pm25 = (Math.random() * 50.0 + 15.0).toFixed(2);       // 15.0 to 65.0 ug/m3\n\nmsg.payload = {\n    \"ts\": ts_int,\n    \"loc_id\": \"SYN-NRED\",\n    \"readings\": [\n        {\n            \"sensor_id\": \"S-TEMP-01\",\n            \"type\": \"temperature\",\n            \"unit\": \"C\",\n            \"val\": parseFloat(temperature)\n        },\n        {\n            \"sensor_id\": \"S-HUM-01\",\n            \"type\": \"humidity\",\n            \"unit\": \"%\",\n            \"val\": parseFloat(humidity)\n        },\n        {\n            \"sensor_id\": \"S-SOIL-01\",\n            \"type\": \"soil_humidity\",\n            \"unit\": \"%\",\n            \"val\": parseFloat(soil_humidity)\n        },\n        {\n            \"sensor_id\": \"S-PM25-01\",\n            \"type\": \"pm25\",\n            \"unit\": \"ug/m3\",\n            \"val\": parseFloat(pm25)\n        }\n    ]\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 320,
        "wires": [
            [
                "debug_output",
                "mqtt_publish"
            ]
        ]
    },
